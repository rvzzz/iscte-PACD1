# Pacotes necessários
library(plotly)
library(dplyr)
# Criar dataframe de exemplo baseado no gráfico original
df <- data.frame(
Dependents = rep(c("No", "Yes"), each = 2),
Gender = rep(c("Female", "Male"), times = 2),
Partner = rep(c("No", "Yes"), times = 2),
SeniorCitizen = c("No", "Yes", "No", "Yes"),
Churn_Count = c(1543, 326, 939, 930, 1200, 669, 1393, 476)  # Frequência
)
# Criar gráfico 3D
fig <- plot_ly(
df,
x = ~Dependents,
y = ~Partner,
z = ~SeniorCitizen,
color = ~Gender,  # Usamos Gender para diferenciar as cores
size = ~Churn_Count,  # Tamanho da barra proporcional ao churn
type = "scatter3d",
mode = "markers"
) %>%
layout(
title = "Distribuição 3D Demográfica para Churn: Yes",
scene = list(
xaxis = list(title = "Dependents"),
yaxis = list(title = "Partner"),
zaxis = list(title = "Senior Citizen")
)
)
# Exibir gráfico
fig
library(rgl)
# Criar coordenadas para cada variável
x <- as.numeric(factor(df$Dependents))
y <- as.numeric(factor(df$Partner))
z <- as.numeric(factor(df$SeniorCitizen))
height <- df$Churn_Count / max(df$Churn_Count)  # Normalizar altura das barras
# Criar gráfico 3D
open3d()
plot3d(x, y, z, col = ifelse(df$Gender == "Female", "red", "blue"), type = "s", size = height*3)
axes3d()
title3d("Distribuição 3D Demográfica para Churn: Yes", xlab="Dependents", ylab="Partner", zlab="Senior Citizen")
