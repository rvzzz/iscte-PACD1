library(plotly)
library(dplyr)
# Criar dataframe baseado no gráfico original
df <- data.frame(
Dependents = rep(c("No", "Yes"), each = 2),
Gender = rep(c("Female", "Male"), times = 2),
Partner = rep(c("No", "Yes"), times = 2),
SeniorCitizen = c("No", "Yes", "No", "Yes"),
Churn_Count = c(1543, 326, 939, 930, 1200, 669, 1393, 476)  # Frequência
)
# Mapeamento das variáveis para os octantes (eixos X e Y)
df <- df %>%
mutate(
X = ifelse(Dependents == "No", 1, -1),  # Define X conforme Dependents
Y = ifelse(Partner == "No", 1, -1),     # Define Y conforme Partner
Z = Churn_Count                         # Define Z como a frequência
)
# Criar gráfico 3D com superfície
fig <- plot_ly(df, x = ~X, y = ~Y, z = ~Z,
type = "scatter3d", mode = "markers",
color = ~Gender,
size = ~Churn_Count / 500,  # Normaliza tamanho dos pontos
marker = list(symbol = 'circle', opacity = 0.8)) %>%
layout(
title = "Distribuição 3D Demográfica para Churn: Yes",
scene = list(
xaxis = list(title = "Dependents (No = +1, Yes = -1)"),
yaxis = list(title = "Partner (No = +1, Yes = -1)"),
zaxis = list(title = "Churn Count")
)
)
# Exibir gráfico
fig
source("00 - carregar bibliotecas e dataset.R")
# Visualizar as primeiras linhas
head(df)
# Estrutura dos dados
str(df)
